package myPack;

import java.util.Arrays;
import java.util.stream.IntStream;

public class RemoveElementFromStream {

	public static void main(String[] args) {
		int [] arr = {1,2,3,4,5,6,7,8};
		int k=2;
		arr = removeIndex(arr,k);
		System.out.println("   "+Arrays.toString(arr));

	}

	private static int[] removeIndex(int[] arr, int k) {
		return IntStream.range(0,arr.length).filter(i->i!=k).map(i->arr[i]).toArray();
	}
}
