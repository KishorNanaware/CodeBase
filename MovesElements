package myPack;

public class MovesElements {

	public static void main(String[] args) {
		int [] inputArr= {10,0,20,30,4,0,5,6,7};
		moveZeroToEnd(inputArr);
	}

	private static int[] moveZeroToEnd(int[] inputArr) {
		int n=inputArr.length;
		int [] temp= new int [n];
		int count=0,j=0;
	
		for(int i=0;i<n;i++) {
			if(inputArr[i]!=0) {
				temp[j]=inputArr[i];
				j++;
				count++;
			}
			
		}
	
		while(count<inputArr.length) {
			temp[count]=0;
			count++;
		}
		for(int i:temp) {
			System.out.print(  " "+i );
		}
		return temp;
	}
}
