package myPack;

public class SecondSmallestNumber {

public static void main(String[] args) {
		
		int [] numberList= {1,2,3,4,5,6,7};
		System.out.println("Second smallest   "+get2ndSmaalest(numberList));
	}

	private static int get2ndSmaalest(int[] numberList) {
		int n= numberList.length;
		int smallest=Integer.MAX_VALUE;
		int SndSmallest=Integer.MAX_VALUE;
		
		for(int i=0;i<n;i++) {
			
			if(numberList[i]<smallest) {
				SndSmallest=smallest;
				smallest=numberList[i];
			}else if(numberList[i]<SndSmallest && numberList[i]!=smallest) {
				SndSmallest=numberList[i];
			}
		}
	
		return  SndSmallest;
	}

}
