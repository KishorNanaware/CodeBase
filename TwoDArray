package flatMap;

import java.util.Arrays;
import java.util.List;
import java.util.stream.Collectors;

public class TwoDArray {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		
		List<List<String>> input2dlist= Arrays.asList(
				Arrays.asList("K","I","S","H","O","R"),
				Arrays.asList("D","N","Y","A","N","E","S","H","W","A","R"),
				Arrays.asList("N","A","N","A","W","A","R","E")
				);
	
		List<String> resultList = input2dlist.stream()
				  .flatMap(list -> list.stream()) // Flattening step
				 .collect(Collectors.toList());
		
		System.out.println(" "+resultList);
	}
}
