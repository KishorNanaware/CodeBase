package flatMap;

import java.util.Arrays;
import java.util.List;
import java.util.stream.Collectors;

public class NestedList {

	public static void main(String[] args) {
	String [] [] dataArray = new String [] [] {{"K","I","S","H","O","R"},{"D","N","Y","A","N","E","S","H","W","A","R"},{"N","A","N","A","W","A","R","E"}};
	
	
	List<String> nameString= Arrays.stream(dataArray).flatMap(d->Arrays.stream(d)).collect(Collectors.toList());
	
	System.out.println("  "+nameString);
	
	}

}
