package myPack;

import java.util.Arrays;
import java.util.List;
import java.util.Objects;
import java.util.stream.Collectors;

public class ListWithException {

	public static void main(String[] args) {
		List<String> fruitList = Arrays.asList("Apple","Mango"," ",null);

		List<String> notNull = fruitList.stream().
				filter(s-> s != null ).
				collect(Collectors.toList());
		
		notNull.forEach(S->System.out.println("  "+S));
		
		List<String> usingObject=fruitList.stream().filter(Objects::nonNull)
				.collect(Collectors.toList());
		
		usingObject.forEach(S->System.out.println("  "+S));
		
	}

}
